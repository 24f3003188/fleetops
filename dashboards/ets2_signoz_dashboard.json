{
  "title": "ETS2 Live Telemetry",
  "description": "Real-time dashboard for Euro Truck Simulator 2",
  "tags": ["gaming", "ets2"],
  "variables": {},
  "widgets": [
    {
      "id": "speed_widget",
      "title": "Truck Speed (km/h)",
      "description": "",
      "panelTypes": ["time_series"],
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "metrics",
              "queryName": "A",
              "aggregateOperator": "avg",
              "aggregateAttribute": {
                "key": "ets2_truck_speed",
                "dataType": "float64",
                "type": "Gauge",
                "isColumn": false,
                "isJSON": false
              },
              "timeAggregation": "timeSeries",
              "spaceAggregation": "avg",
              "functions": [],
              "filters": {
                "items": [],
                "op": "AND"
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "Speed"
            }
          ]
        }
      }
    },
